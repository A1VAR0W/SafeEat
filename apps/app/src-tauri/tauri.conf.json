{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SafeEat",
  "version": "2.0.3",
  "identifier": "com.a1var0w.safeeat",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": { "script": "trunk build --release", "cwd": "../ui" },
    "beforeDevCommand": { "script": "trunk serve --port 1420", "cwd": "../ui", "wait": false }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "SafeEat" }],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost https://tiles.openfreemap.org",
        "img-src": "'self' data: blob: https:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "worker-src": "'self' blob:",
        "font-src": "'self' data: https://tiles.openfreemap.org"
      }
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"],
    "android": { "minSdkVersion": 26, "versionCode": 2000000 }
  }
}
