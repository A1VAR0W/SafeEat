{
  "name": "safeeat",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "scripts": {
    "dev": "concurrently -n api,web \"npm run api\" \"npm run web\"",
    "api": "npm run dev -w @safeeat/api",
    "web": "npm run dev -w @safeeat/web",
    "mobile": "npm run start -w @safeeat/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "build": "npm run build:api && npm run build:web",
    "build:api": "npm run build -w @safeeat/api",
    "build:web": "npm run build -w @safeeat/web",
    "db:migrate": "npm run migrate -w @safeeat/api",
    "mobile:check": "npm exec -w @safeeat/mobile -- expo install --check",
    "mobile:export": "npm exec -w @safeeat/mobile -- expo export --platform all"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.19.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "expo-router": "^55.0.18",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4",
    "yaml": "^2.8.1"
  },
  "overrides": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  }
}
